trust-policy = off
# aube is our local/CI package manager; Cloudflare Pages invokes pnpm
# directly instead (aube isn't available there). package.json intentionally
# has no `packageManager` field, since Cloudflare's build system hard-fails
# on any value it doesn't recognize (only npm/yarn/pnpm/bun). This setting
# is a defensive no-op kept in case a `packageManager` field is reintroduced
# in the future (pnpm <11).
package-manager-strict = false
